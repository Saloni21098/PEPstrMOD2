source leaprc.protein.ff14SB
source leaprc.water.tip3p
set default PBRadii bondi

loadAmberPrep /home/iiitd/Desktop/Saloni25/PEPstrMOD2/fixed_ffct/NFA.prepin
loadAmberParams /home/iiitd/Desktop/Saloni25/PEPstrMOD2/fixed_ffct/NFA.frcmod
mol = loadpdb /home/iiitd/Desktop/Saloni25/PEPstrMOD2/test/test/test_NFA_aligned.pdb

# Neutralize negative system
addions mol Na+ 0

# Vacuum environment: no solvation applied

# Save outputs
savepdb mol test_tleap.pdb
saveamberparm mol test.prmtop test.inpcrd
quit
